{
  "version": 2,
  "defaults": {
    "enabled": true,
    "start_up_delay_ms": 3000,
    "injected_libraries": [
      { "path": "/data/local/tmp/re.zyg.fri/libgadget.so" }
    ],
    "hot_reload": true,
    "reload_interval_ms": 1500,
    "stealth": {
      "enabled": true,
      "remap": true,
      "rename_threads": true,
      "unlink_payload": true,
      "remap_delay_ms": 750,
      "thread_alias": "Jit thread pool"
    }
  },
  "profiles": {
    "hook": {},
    "kill-children": {
      "child_gating": { "enabled": true, "mode": "kill" }
    }
  },
  "targets": {
    "com.example.app": "hook"
  }
}
